{
  "name": "dsh-git-commit-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated Git commit planning and execution agent for DSH: analyses status/diff, materialises an exact add/commit plan, binds user approval to a plan revision, and runs a restricted git CLI executor.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "node scripts/clean.mjs",
    "inject:dev": "npm run build:client && NODE_ENV=development node node_modules/@havocrao/dsh-code-finder/bin/code-finder.js instrument dist/client --write",
    "inject:revert": "npm run build:client",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && npm run build:test && npm run test:unit",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "node --test --test-concurrency=1 \".build/tests/*.test.js\"",
    "verify": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@havocrao/dsh-code-finder": "file:../../DSH-code-finder",
    "@types/node": "^22.20.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
